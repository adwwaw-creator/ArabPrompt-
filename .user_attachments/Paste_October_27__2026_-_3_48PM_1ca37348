def num(row, key, default, line):
    v = (row.get(key) or "").strip().replace(",", ".") if isinstance(row.get(key), str) else row.get(key)
    إذا كان v في (لا شيء، ""):
        إذا كانت القيمة الافتراضية هي None:
            raise DataError(f"السطر {line}: '{key}' مطلوب")
        أعد القيمة الافتراضية (float)
    يحاول:
        x = float(v)
    باستثناء خطأ القيمة:
        raise DataError(f"line {line}: '{key}' must be a number, got '{v}'")
    إذا كانت قيمة x أقل من الصفر:
        raise DataError(f"line {line}: '{key}' cannot be negative")
    إرجاع x


def read_csv(text):
    first = text.splitlines()[0] if text.strip() else ''
    delim = ";" if first.count(";") > first.count(",") else ","
    rd = csv.DictReader(io.StringIO(text), delimiter=delim)
    إذا لم تكن rd.fieldnames أو لم تكن {"appliance", "watts", "hours_per_day"} <= {f.strip().lower() for f in rd.fieldnames}:
        إذا لم يكن rd.fieldnames أو "kwh_per_year" موجودًا في [f.strip().lower() for f in rd.fieldnames]:
            رفع خطأ في البيانات ("يحتاج ملف CSV إلى أعمدة الجهاز، والواط، والساعات_في_اليوم (أو الكيلوواط_في_السنة)")
    العناصر = []
    for line, raw in enumerate(rd, 2):
        row = {(k or "").strip().lower(): v for k, v in raw.items()}
        name = (row.get("appliance") or "").strip()
        إذا لم يكن الاسم:
            يستمر
        label = (row.get("kwh_per_year") or "").strip()
        it = {"appliance": name,
              "واط": num(row, "واط", 0 إذا كانت التسمية وإلا None, line),
              "الساعات": num(row, "hours_per_day", 24 if label else None, line),
              "الأيام": num(الصف، "أيام_في_الأسبوع"، 7، السطر)،
              "الكمية": رقم(الصف، "الكمية"، 1، السطر)،
              "الواجب": num(row, "duty_cycle_pct", 100, line),
              "standby_w": num(row, "standby_watts", 0, line),
              "label_kwh": num(row, "kwh_per_year", 0, line) if label else None,
              "خارج أوقات الذروة": num(row, "offpeak_pct", 0, line) / 100,
              "أشهر": num(row, "أشهر_في_السنة", 12, line)}
        إذا كانت ساعات العمل > 24:
            raise DataError(f"line {line}: hours_per_day {it['hours']:g} > 24")
        إذا كان it["days"] > 7 أو it["duty"] > 100 أو it["offpeak"] > 1 أو it["months"] > 12:
            رفع خطأ في البيانات (f"line {line}: days_per_week <= 7, months_per_year <= 12, duty_cycle_pct and offpeak_pct <= 100")
        items.append(it)
    إذا لم تكن هناك عناصر:
        رفع خطأ في البيانات ("لا توجد أجهزة في ملف CSV")
    المنتجات القابلة للإرجاع


