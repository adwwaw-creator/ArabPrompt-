TEXT_RE = re.compile(r"^\s*# (\S+) (سيتم إنشاؤه|سيتم حذفه|سيتم تحديثه في مكانه|يجب استبداله|سيتم قراءته أثناء التطبيق|لن تتم إدارته بواسطة Terraform))"


def review_text(text):
    text = re.sub(r"\x1b\[[0-9;]*m", "", text)
    lines = text.splitlines()
    التغييرات، النتائج = [], []
    i = 0
    بينما i < len(lines):
        m = TEXT_RE.match(lines[i])
        إذا لم يكن m:
            i += 1; استمر
        addr, verb = m.group(1), m.group(2)
        rtype = re.sub(r"^(module\.[^.]+\.)*", "", addr).split(".")[0]
        إذا كان العنوان يبدأ بـ "data." أو ".data." في العنوان أو "قراءة أثناء التطبيق" في الفعل:
            i += 1; استمر
        block, j = [], i + 1
        بينما j < len(lines) و ليس TEXT_RE.match(lines[j]) و ليس lines[j].startswith("Plan:"):
            block.append(lines[j]); j += 1
        first = next((l.strip() for l in block if l.strip() and not l.strip().startswith("#")), "")
        السبب = التالي((l.strip()[3:-1] for l in block[:3] if l.strip().startswith("# (")), "")
        نوع = {"سيتم إنشاؤه": "إنشاء", "سيتم تدميره": "تدمير", "سيتم تحديثه في مكانه": "تحديث",
                لن تتم إدارتها بواسطة Terraform بعد الآن: "forget"}.get(verb)
        إذا كان الفعل يساوي "يجب استبداله":
            kind = "استبدال (إنشاء أولًا)" إذا كان أولًا يبدأ بـ "+/-") وإلا "استبدال (حذف أولًا)"
        forced = [re.sub(r"^[~+\-/ ]+", "", l.strip()).split(" ")[0] for l in block if "# forces replacement" in l]
        rc = {"address": addr, "type": rtype, "change": {"actions": {"create": ["create"], "update": ["update"], "destroy": ["delete"], "forget": ["forget"],
              "استبدال (إنشاء أولاً): ["إنشاء"، "حذف"]، "استبدال (تدمير أولاً): ["حذف"، "إنشاء"]}[النوع]،
              "replace_paths": [[f] for f in forced]}}
        إذا كانت قيمة "خارج نطاق العد" في السبب أو قيمة "مؤشر العد" في السبب:
            rc["action_reason"] = "delete_because_count_index"
        elif "not in for_each map" in reason:
            rc["action_reason"] = "delete_because_each_key"
        elif "not in configuration" in reason:
            rc["action_reason"] = "delete_because_no_resource_config"
        k, f = review_change(rc)
        changes.append((k, addr))
        النتائج += f
        i = j
    إذا لم تكن هناك تغييرات، و"لا تغييرات" غير موجودة في النص:
        raise ValueError("لم يتم العثور على أي تغييرات في الموارد؛ هل هذا ناتج خطة Terraform؟")
    findings.append(finding("INFO", "TEXT_MODE", "-", "خطة النص: تم فحص الإجراءات فقط، وليس قيم السمات (IAM، الدخول، علامات الحماية)",
                            قم بتشغيل الأمر `terraform show -json plan.out > plan.json` وراجع ملف JSON للتأكد من اكتمال جميع العمليات.
    إرجاع التغييرات والنتائج، "إصدار غير معروف (خطة النص)"


def summarize(changes, findings):
    counts = {}
    لكل k، _ في التغييرات:
        المفتاح = "استبدال" إذا كان k.يبدأ بـ "استبدال" وإلا k
        counts[key] = counts.get(key, 0) + 1
    findings.sort(key=lambda f: (SEV_ORDER[f["severity"]], f["resource"]))
    sev = {s: sum(1 for f in findings if f["severity"] == s ) for s in SEV_ORDER}
    إذا كان مستوى الخطورة ["عالي"]:
        الحكم = "لا يُطبّق كما هو: يجب حلّ أو قبول كل نتيجة عالية بشكل صريح"
    elif sev["MEDIUM"]:
        النتيجة = "يُطبق بعد المراجعة: النتائج المتوسطة تتطلب موافقة المالك"
