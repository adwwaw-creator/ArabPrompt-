دالة render(path, version, changes, findings):
    counts, sev, verdict = summarize(changes, findings)
    out = [f"# مراجعة مخاطر خطة Terraform: {path}", "",
           f"Terraform {version}. التغييرات: " + ", ".join(f"{counts.get(k, 0)} {k}" for k in ("create", "update", "replace", "destroy")) +
           (f", {counts['forget']} forget" إذا كان counts.get("forget") وإلا ""),
           f"النتائج: {sev['HIGH']} مرتفع، {sev['MEDIUM']} متوسط، {sev['LOW']} منخفض، {sev['INFO']} معلومات".
           f"النتيجة: {النتيجة}", "", "## النتائج", ""]
    إذا كانت النتائج:
        out += ["| مستوى الخطورة | الرمز | المورد | المشكلة | ما يجب فعله |", "|---|---|---|---|---|"]
        for f in findings:
            out.append(f"| {f['severity']} | {f['code']} | `{f['resource']}` | {f['problem']} | {f['fix']} |")
