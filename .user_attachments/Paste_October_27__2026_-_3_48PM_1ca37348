        for r in rows:
            إذا كان r["terrain"] في ("scramble", "snow") و r["end_min"] > sunset - 120:
                findings.append(("متوسط", "أرض صلبة متأخرة", f"{r['leg']} ({r['terrain']}) ينتهي عند {r['end']}، في غضون ساعتين من غروب الشمس؛ أرجل متعبة وضوء خافت على أرض صلبة"))
    إذا كان المجموع المتحرك > 8 * 60:
        findings.append(("LOW", "LONG_DAY", f"{dur(moving_total)} وقت الحركة؛ تحقق من أن الجميع قد قضى يومًا بهذا الطول مؤخرًا"))
    إذا كانت درجة الحرارة >= 28 وكان أي من (l["ascent_m"] >= 300 لكل l في legs):
