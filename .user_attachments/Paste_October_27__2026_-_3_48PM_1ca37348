        الحركة = القاعدة * التضاريس[الساق["التضاريس"]] * اللياقة * عامل التعبئة
        المجموع = الحركة * (1 + دقائق الاستراحة / 60)
        الماء = الإجمالي / 60 * المعدل + جزء["صعود_متر"] / 100 * 0.1
        t_start, t = t, t + total
        rows.append({**leg, "moving_min": round(moving), "with_breaks_min": round(total),
                     "start": clock(t_start), "end": clock(t), "end_min": t, "water_l": round(water, 2), "steep": steep})
        تمدد += ماء
        stretch_legs.append(leg["leg"])
        إذا كان leg["water_at_end"]:
            stretches.append((stretch, stretch_legs)); stretch, stretch_legs = 0.0, []
        إذا كان المنحدر حادًا:
            findings.append(("LOW", "STEEP_LEG", f"{leg['leg']}: متوسط ​​الانحدار فوق 25%؛ توقع أن يكون التقدم أبطأ من المعادلة، وتوخ الحذر أثناء النزول"))
    إذا كانت خاصية تمديد الأرجل:
        stretches.append((stretch, stretch_legs))
    moving_total = sum(r["moving_min"] for r in rows)
    المجموع = t - البداية
    الحمل = الحد الأقصى (s لـ s، _ في الامتدادات) + 0.5
    بالنسبة لـ s، الأسماء الممتدة:
        إذا كان s + 0.5 > 3.0:
            findings.append(("MEDIUM", "LONG_DRY_STRETCH", f"{' -> '.join(names)}: {s + 0.5:.1f} لتر لحملها بدون إعادة تعبئة؛ أضف عبوة إعادة تعبئة، أو خزّن الماء، أو ابدأ مبكرًا في الثلاجة"))
    ملخص = {
        "distance_km": round(sum(l["distance_km"] for l in legs), 1),
        "ascent_m": round(sum(l["ascent_m"] for l in legs)),
        "descent_m": round(sum(l["descent_m"] for l in legs)),
        "moving_min": round(moving_total), "total_min": round(total),
        "بدء": clock(start)، "إنهاء": clock(t)،
        "water_total_l": round(sum(r["water_l"] for r in rows), 1),
        "carry_max_l": round(carry, 1),
        "food_kcal": int(round(total / 60 * 250, -1)),
        معدل_الماء_لتر_لكل_ساعة: المعدل، عامل_التعبئة: تقريب(عامل_التعبئة، 2)،
    }
    إذا لم يكن غروب الشمس هو "لا شيء":
        اليسار = غروب الشمس - t
        summary["sunset"] = clock(sunset)
        summary["minutes_before_sunset"] = round(left)
        summary["latest_start"] = clock(sunset - margin - total)
        إذا كان اليسار < 0:
            findings.append(("HIGH", "AFTER_DARK", f"إنهاء {clock(t)} بعد {dur(-left)} من غروب شمس {clock(sunset)}؛ ابدأ من {summary['latest_start']}، اختصر المسار أو خطط للانسحاب"))
        elif left < margin:
