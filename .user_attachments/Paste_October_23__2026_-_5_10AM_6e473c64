ملف app.js — منطق الواجهة

```javascript
let allConcepts = [];
let currentGenre = 'الكل';
let currentSearch = '';

// تحميل البيانات
async function init() {
    allConcepts = await loadLibrary();
    renderFilters();
    renderStats();
    renderGrid();
}

// عرض أزرار الفلاتر
function renderFilters() {
    const genres = ['الكل', ...new Set(allConcepts.map(c => c.genre))];
    const container = document.getElementById('genreFilters');
    container.innerHTML = genres.map(g => 
        `<button class="filter-btn ${g === currentGenre ? 'active' : ''}" 
                 data-genre="${g}">${g}</button>`
    ).join('');

    container.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            currentGenre = btn.dataset.genre;
            renderFilters();
            renderGrid();
        });
    });
}

// إحصائيات
function renderStats() {
    const stats = document.getElementById('stats');
    const filtered = getFiltered();
    stats.textContent = `عرض ${filtered.length} من ${allConcepts.length} مفهوماً`;
}

// فلترة
function getFiltered() {
    return allConcepts.filter(c => {
        const genreMatch = currentGenre === 'الكل' || c.genre === currentGenre;
        const searchMatch = !currentSearch || 
            c.title.includes(currentSearch) || 
            c.narrative.includes(currentSearch) ||
            c.genre.includes(currentSearch);
        return genreMatch && searchMatch;
    });
}

// عرض الشبكة
function renderGrid() {
    const grid = document.getElementById('grid');
    const filtered = getFiltered();
    renderStats();

    if (filtered.length === 0) {
        grid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #8C9BA5; padding: 3rem;">لا توجد نتائج مطابقة</p>';
        return;
    }

    grid.innerHTML = filtered.map(c => `
        <div class="card" data-id="${c.id}">
            <div class="card-visual">
                <div class="palette">
                    ${c.palette.map(color => `<div class="swatch" style="background:${color}"></div>`).join('')}
                </div>
                <span class="card-genre">${c.genre}</span>
            </div>
            <div class="card-body">
                <h3>${c.id}. ${c.title}</h3>
                <p>${c.narrative}</p>
                <div class="card-meta">
                    <span>📐 ${c.aspect_ratio}</span>
                    <span>🎭 ${c.mood}</span>
                </div>
            </div>
        </div>
    `).join('');

    grid.querySelectorAll('.card').forEach(card => {
        card.addEventListener('click', () => openModal(parseInt(card.dataset.id)));
    });
}

// فتح نافذة التفاصيل
function openModal(id) {
    const c = allConcepts.find(x => x.id === id);
    if (!c) return;

    const modal = document.getElementById('modal');
    const body = document.getElementById('modalBody');

    body.innerHTML = `
        <h2>${c.id}. ${c.title}</h2>
        <p><strong>الجنس:</strong> ${c.genre} | <strong>المزاج:</strong> ${c.mood} | <strong>النسبة:</strong> ${c.aspect_ratio}</p>
        
        <h3>📖 السرد</h3>
        <p>${c.narrative}</p>
        
        <h3>🎨 التكوين والبصريات</h3>
        <p><strong>التكوين:</strong> ${c.composition}</p>
        <p><strong>البصريات:</strong> ${c.optics}</p>
        
        <h3>💡 الإضاءة والملامس</h3>
        <p><strong>الإضاءة:</strong> ${c.lighting}</p>
        <p><strong>الملامس:</strong> ${c.textures}</p>
        
        <h3>🎨 اللوحة اللونية</h3>
        <div class="palette-row">
            ${c.palette.map(color => `<div class="swatch-lg" style="background:${color}" title="${color}"></div>`).join('')}
        </div>
        
        <h3>🚀 Master Prompt</h3>
        <div class="prompt-box">
            <button class="copy-btn" onclick="copyPrompt(this)">نسخ</button>
            ${escapeHtml(c.master_prompt)} --ar ${c.aspect_ratio} --style raw --v 6.1
        </div>
        
        <h3>📝 Natural Prompt</h3>
        <div class="prompt-box">
            <button class="copy-btn" onclick="copyPrompt(this)">نسخ</button>
            ${escapeHtml(c.natural_prompt)}
        </div>
    `;

    modal.classList.remove('hidden');
}

// نسخ البرومبت
function copyPrompt(btn) {
    const text = btn.parentElement.textContent.replace('نسخ', '').trim();
    navigator.clipboard.writeText(text).then(() => {
        btn.textContent = '✓ تم';
        setTimeout(() => btn.textContent = 'نسخ', 1500);
    });
}

function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}

// إغلاق النافذة
document.getElementById('closeModal').addEventListener('click', () => {
    document.getElementById('modal').classList.add('hidden');
});

document.getElementById('modal').addEventListener('click', (e) => {
    if (e.target.id === 'modal') {
        document.getElementById('modal').classList.add('hidden');
    }
});

// البحث
document.getElementById('searchBox').addEventListener('input', (e) => {
    currentSearch = e.target.value.trim();
    renderGrid();
});

// بدء التطبيق
init();
