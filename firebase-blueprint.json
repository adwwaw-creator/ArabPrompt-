{
  "entities": {
    "visitors": {
      "title": "Visitors",
      "description": "Tracking metrics for unique visitors count on ArabPrompt",
      "type": "object",
      "properties": {
        "count": {
          "type": "number",
          "description": "The current verified unique visitor count starting from 0"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the counter was last incremented"
        },
        "recentLogs": {
          "type": "array",
          "description": "List of recent genuine visitor sessions to know who entered the site",
          "items": {
            "type": "object"
          }
        }
      },
      "required": ["count"]
    },
    "users": {
      "title": "Users",
      "description": "Securely tracks registered users synced with Firebase Auth",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Google user ID matching authenticated user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Google verified email of the user"
        },
        "displayName": {
          "type": "string",
          "description": "Human-friendly display name of the user"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar image link of the logged-in user"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the Google email is verified by Auth"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user profile was created in Firestore"
        },
        "lastActive": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user was last active"
        },
        "plan": {
          "type": "string",
          "description": "Active subscription tier: free, pro, or studio"
        },
        "subscriptionStatus": {
          "type": "string",
          "description": "Subscription status: active, cancelled, or trial"
        },
        "billingCycle": {
          "type": "string",
          "description": "Billing cycle: monthly or annual"
        },
        "renewalDate": {
          "type": "string",
          "format": "date-time",
          "description": "Next renewal or expiration timestamp"
        }
      },
      "required": ["uid", "email"]
    },
    "history": {
      "title": "Prompt History Items",
      "description": "Engineered prompts history generated by the user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique locally generated prompt history ID"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when this generation was saved"
        },
        "originalText": {
          "type": "string",
          "description": "The original short user core input concept"
        },
        "optimizedText": {
          "type": "string",
          "description": "The fully engineered prompt generated by Gemini"
        },
        "translatedText": {
          "type": "string",
          "description": "The bilingual Arabic translation output"
        },
        "model": {
          "type": "string",
          "description": "The selected target AI model"
        },
        "tone": {
          "type": "string",
          "description": "The specific aesthetic tone selected"
        },
        "category": {
          "type": "string",
          "description": "Target category context"
        },
        "actionType": {
          "type": "string",
          "description": "Operation type: generate, refine, translate, or reverse"
        },
        "isFallback": {
          "type": "boolean",
          "description": "Whether elegant client-side fallback was used"
        },
        "styleImage": {
          "type": "string",
          "description": "URL of source layout or style imagery if in copy mode"
        },
        "contentImage": {
          "type": "string",
          "description": "URL of the content guide imagery"
        },
        "notes": {
          "type": "string",
          "description": "Custom prompt design directions"
        },
        "isMimicMode": {
          "type": "boolean",
          "description": "Is style mimic enabled"
        },
        "isFavorite": {
          "type": "boolean",
          "description": "Whether the item is starred by the user"
        }
      },
      "required": ["id", "timestamp", "originalText", "optimizedText", "model", "tone", "category"]
    },
    "sequences": {
      "title": "Video Sequence Projects",
      "description": "Saved video sequences and storyboards to resume work later",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique sequence project ID"
        },
        "title": {
          "type": "string",
          "description": "Human-friendly project title"
        },
        "concept": {
          "type": "string",
          "description": "The main narrative or concept"
        },
        "anchorStyle": {
          "type": "string",
          "description": "Overarching visual anchor style"
        },
        "aspectRatio": {
          "type": "string",
          "description": "Target video aspect ratio"
        },
        "transitionEffect": {
          "type": "string",
          "description": "Transition effect between clips"
        },
        "scenes": {
          "type": "array",
          "description": "List of scene prompt items in the sequence",
          "items": {
            "type": "object"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when sequence was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when sequence was last updated"
        }
      },
      "required": ["id", "title", "concept", "scenes", "createdAt", "updatedAt"]
    },
    "movie_projects": {
      "title": "Cinema Movie Projects",
      "description": "User saved cinematic screenplay projects with 10-second scene pacing, facial consistency anchors, and dialogue lip-sync",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique movie project ID"
        },
        "titleAr": {
          "type": "string",
          "description": "Arabic title of the film"
        },
        "titleEn": {
          "type": "string",
          "description": "English title of the film"
        },
        "concept": {
          "type": "string",
          "description": "Original movie premise or concept"
        },
        "genre": {
          "type": "string",
          "description": "Film genre preset"
        },
        "visualStyle": {
          "type": "string",
          "description": "Visual cinematography aesthetic preset"
        },
        "targetAiModel": {
          "type": "string",
          "description": "Target video generation AI model"
        },
        "loglineAr": {
          "type": "string",
          "description": "Arabic core story logline"
        },
        "loglineEn": {
          "type": "string",
          "description": "English core story logline"
        },
        "storySynopsisAr": {
          "type": "string",
          "description": "Arabic story narrative synopsis"
        },
        "storySynopsisEn": {
          "type": "string",
          "description": "English story narrative synopsis"
        },
        "characterAnchor": {
          "type": "object",
          "description": "Master character facial consistency anchor"
        },
        "scenes": {
          "type": "array",
          "description": "10-second cinematic scenes list with screenplay beats, dialogue, lip-sync, and video prompts",
          "items": {
            "type": "object"
          }
        },
        "totalDurationSeconds": {
          "type": "number",
          "description": "Total duration in seconds (scenes count * 10)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when movie was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when movie was last updated"
        }
      },
      "required": ["id", "titleAr", "concept", "scenes", "createdAt", "updatedAt"]
    },
    "shared_sequences": {
      "title": "Shared Sequence Snapshots",
      "description": "Publicly shareable immutable sequence snapshots for cross-user prompt sharing",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique share ID"
        },
        "type": {
          "type": "string",
          "description": "Type of sequence: storyboard or cinema"
        },
        "title": {
          "type": "string",
          "description": "Title of the shared sequence"
        },
        "concept": {
          "type": "string",
          "description": "Core narrative concept"
        },
        "anchorStyle": {
          "type": "string",
          "description": "Visual anchor style or aesthetic preset"
        },
        "aspectRatio": {
          "type": "string",
          "description": "Aspect ratio"
        },
        "transitionEffect": {
          "type": "string",
          "description": "Transition effect"
        },
        "scenes": {
          "type": "array",
          "description": "List of scenes with prompts",
          "items": {
            "type": "object"
          }
        },
        "characterAnchor": {
          "type": "object",
          "description": "Optional character face anchor for cinema projects"
        },
        "authorName": {
          "type": "string",
          "description": "Optional display name of creator"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of creation"
        }
      },
      "required": ["id", "title", "scenes", "createdAt"]
    }
  },
  "firestore": {
    "visitors/{id}": {
      "schema": "visitors",
      "description": "Contains metadata and the singular global counter tracking visitor numbers securely"
    },
    "users/{userId}": {
      "schema": "users",
      "description": "Contains private and public profile data for Google authenticated users"
    },
    "users/{userId}/history/{itemId}": {
      "schema": "history",
      "description": "User specific prompt history log saved to the cloud"
    },
    "users/{userId}/sequences/{seqId}": {
      "schema": "sequences",
      "description": "User specific saved video sequences and storyboards"
    },
    "users/{userId}/movie_projects/{movieId}": {
      "schema": "movie_projects",
      "description": "User specific Cinema Movie Projects with 10s screenplay and character face anchors"
    },
    "shared_sequences/{shareId}": {
      "schema": "shared_sequences",
      "description": "Publicly readable immutable sequence snapshots for sharing unique links"
    }
  }
}
