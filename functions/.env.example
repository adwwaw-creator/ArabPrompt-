# ==============================================================================
# Cloud Functions Environment Variables (Secure Backend)
# ==============================================================================
# IMPORTANT:
# - NEVER store production API keys directly in client-side code.
# - In Firebase Cloud Functions, use Google Cloud Secret Manager for production:
#     firebase functions:secrets:set GEMINI_API_KEY
# - For local testing with the Firebase emulator, you can set GEMINI_API_KEY here:
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed origins for CORS (comma separated, or * for open access)
ALLOWED_ORIGINS=https://arabiprompt.ai.studio,http://localhost:3000,http://localhost:5173
